# Generated from tp_sg.sby (sby --dumpcfg tp_sg.sby tp_timing). Edit tp_sg.sby, then regenerate.

[options]
mode bmc
depth 80
skip 45

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang --ignore-timing --single-unit --allow-use-before-declare -D TIMING -G LEAD=16    --top tp_sg_formal -f files.f
prep -top tp_sg_formal
# Stub outputs are undriven on purpose: make them unconstrained every cycle.
setundef -undriven -anyseq
# Flip-flops without an init value power up at 0, as FPGA registers do (INIT default).
setundef -init -zero

