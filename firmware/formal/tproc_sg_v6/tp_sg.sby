# SymbiYosys checks for tProc v2 -> axis_signal_gen_v6 (dispatcher, cdcsync, translator, generator).
# See ../README.md. For parallel runs, dump one task per file:
#   sby --dumpcfg tp_sg.sby <task> > par_<task>.sby
#
# The tProc core starts ~31 cycles after reset (it waits for its XPM FIFOs to leave reset),
# so nothing can reach the generator before ~cycle 50; 'skip' saves solver time there.
#
# tp_cov       cover traces: a timed tProc command reaches the DAC; K commands reach the generator
# tp_disp_cov  non-vacuity for tp_disp: K commands handed over, one after back-pressure
# tp_disp      dispatcher port output with any consumer: exactly once, in order, AXIS-stable
# tp_order     generator input, other channel always ready: exactly once, in order, unchanged
# tp_xchan     same, but the other channel's consumer may hold tready low (expected to FAIL)
# tp_timing    generator accepts each command exactly D cycles after tProc time T (lead 16)
# tp_lead<N>   same with the core writing only N cycles ahead of T
# tp_len       any 32-bit tProc pulse length: the generator gets the length asked for

[tasks]
tp_cov
tp_disp_cov
tp_disp
tp_order
tp_xchan
tp_timing
tp_lead4
tp_lead8
tp_lead12
tp_len

[options]
tp_cov:      mode cover
tp_cov:      depth 100
tp_disp_cov: mode cover
tp_disp_cov: depth 75
tp_disp:     mode bmc
tp_disp:     depth 75
tp_disp:     skip 40
tp_order:    mode bmc
tp_order:    depth 80
tp_order:    skip 45
tp_xchan:    mode bmc
tp_xchan:    depth 60
tp_timing:   mode bmc
tp_timing:   depth 80
tp_timing:   skip 45
tp_lead4:    mode bmc
tp_lead4:    depth 70
tp_lead4:    skip 45
tp_lead8:    mode bmc
tp_lead8:    depth 70
tp_lead8:    skip 45
tp_lead12:   mode bmc
tp_lead12:   depth 75
tp_lead12:   skip 45
tp_len:      mode bmc
tp_len:      depth 70
tp_len:      skip 45

[engines]
smtbmc yices

[script]
plugin -i slang
tp_cov:      read_slang --ignore-timing --single-unit --allow-use-before-declare                         --top tp_sg_formal -f files.f
tp_disp_cov: read_slang --ignore-timing --single-unit --allow-use-before-declare -D DISP_AXIS            --top tp_sg_formal -f files.f
tp_disp:     read_slang --ignore-timing --single-unit --allow-use-before-declare -D DISP_AXIS            --top tp_sg_formal -f files.f
tp_order:    read_slang --ignore-timing --single-unit --allow-use-before-declare                         --top tp_sg_formal -f files.f
tp_xchan:    read_slang --ignore-timing --single-unit --allow-use-before-declare -D BLOCK0               --top tp_sg_formal -f files.f
tp_timing:   read_slang --ignore-timing --single-unit --allow-use-before-declare -D TIMING -G LEAD=16    --top tp_sg_formal -f files.f
tp_lead4:    read_slang --ignore-timing --single-unit --allow-use-before-declare -D TIMING -G LEAD=4     --top tp_sg_formal -f files.f
tp_lead8:    read_slang --ignore-timing --single-unit --allow-use-before-declare -D TIMING -G LEAD=8     --top tp_sg_formal -f files.f
tp_lead12:   read_slang --ignore-timing --single-unit --allow-use-before-declare -D TIMING -G LEAD=12    --top tp_sg_formal -f files.f
tp_len:      read_slang --ignore-timing --single-unit --allow-use-before-declare -D LEN32                --top tp_sg_formal -f files.f
prep -top tp_sg_formal
# Stub outputs are undriven on purpose: make them unconstrained every cycle.
setundef -undriven -anyseq
# Flip-flops without an init value power up at 0, as FPGA registers do (INIT default).
setundef -init -zero

[files]
files.f
xpm_cdc.sv    C:/AMDDesignTools/2026.1/data/ip/xpm/xpm_cdc/hdl/xpm_cdc.sv
xpm_memory.sv C:/AMDDesignTools/2026.1/data/ip/xpm/xpm_memory/hdl/xpm_memory.sv
xpm_fifo.sv   C:/AMDDesignTools/2026.1/data/ip/xpm/xpm_fifo/hdl/xpm_fifo.sv
../../hdl/fifo_xpm.sv
../../hdl/fifo_dc_axi_xpm.sv
../../ip/axis_signal_gen_v6/src/latency_reg.v
../../ip/axis_signal_gen_v6/src/ctrl_sg_v6.sv
../../ip/axis_signal_gen_v6/src/signal_gen.v
../../ip/axis_signal_gen_v6/src/signal_gen_top.v
../axis_signal_gen_v6/models/formal_stubs.sv
../../ip/qick_processor/src/_qproc_defines.svh
../../ip/qick_processor/src/_qproc_ips.sv
models/qproc_dispatcher_formal.sv
../../ip/axis_cdcsync_v1/src/cdcsync.sv
../../ip/qick_sg_translator/src/sg_translator.v
tp_sg_formal.sv
